# Модуль 1. Урок 5: Списки и преобразование элементов (each, enumerate, flatten)
# Задача: Сгладить вложенный список [[100, 200], [50, 150]],
# увеличить каждый элемент на 20% и оставить значения строго больше 100.

[[100, 200], [50, 150]]
| flatten
| each { |price| $price * 1.2 }
| where $it > 100
